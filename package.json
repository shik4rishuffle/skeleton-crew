{
  "name": "skeleton-crew",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tinacms dev -c \"next dev --port 3200\"",
    "build": "tinacms build && next build",
    "build:local": "tinacms build --local --skip-cloud-checks && next build",
    "preview": "npx serve@latest out",
    "test:before-mode": "node scripts/check-before-mode.mjs"
  },
  "dependencies": {
    "@skeleton-crew/blocks": "github:shik4rishuffle/skeleton-crew-blocks#v0.2.2",
    "@tinacms/cli": "^3.0.0",
    "@tinacms/mdx": "^1.0.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tinacms": "^3.14.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
