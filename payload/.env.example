DATABASE_URI=postgres://payload:secret@localhost:5432/payload
PAYLOAD_SECRET=replace-with-random-32-char-string
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Better Justice - Stripe payment integration
# Test-mode keys in dev (Flynn's dashboard); live-mode keys via skeleton promote (Paul's dashboard, see AGENTS/backend-promote-checklist.md)
STRIPE_SECRET_KEY=sk_test_replace_me
# Endpoint secret for stripe.webhooks.constructEvent. Different per environment. Dev: from `stripe listen` CLI output. Prod: from Stripe dashboard webhook endpoint config.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Publishable key. Surfaced to frontend via SiteSettings.stripePublishableKey, not read directly by the browser from env. Test-mode in dev, live-mode in prod.
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Frontend origin used to build Stripe Checkout success_url and cancel_url. Dev: https://betterjustice.{DEV_DOMAIN}. Prod: https://betterjustice.org.uk
BJ_FRONTEND_ORIGIN=http://localhost:8080
